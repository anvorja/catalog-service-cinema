DATABASE_URL=postgresql://user:password@host:port/cinema_catalog

REDIS_URL=redis://user:password@host:port
CACHE_HOME_TTL=120
CACHE_DEFAULT_TTL=300

KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=

JWT_SECRET=
JWT_ALGORITHM=HS256

# URL interna al booking-service
# Local (Docker):      http://booking-service:8004
# Producción (Render): booking-service-cinema-<sufijo>.onrender.com
BOOKING_SERVICE_URL=

# Debe coincidir con INTERNAL_SERVICE_TOKEN en booking-service-cinema
INTERNAL_SERVICE_TOKEN=
